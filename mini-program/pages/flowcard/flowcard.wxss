.flow-card {
  padding: 16px;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
}

.flow-body {
  display: flex;
  border: 1px solid #1F2937;
  border-radius: 4px;
  overflow: hidden;
}

.info-table {
  flex: 1;
  border-right: 1px solid #1F2937;
}

.table-row {
  display: flex;
  border-bottom: 1px solid #1F2937;
  min-height: 40px;
  align-items: center;
}

.table-row:last-child {
  border-bottom: none;
}

.table-label {
  width: 80px;
  padding: 8px 12px;
  border-right: 1px solid #1F2937;
  font-weight: 500;
  background: #FAFAFA;
  color: #374151;
}

.table-value {
  flex: 1;
  padding: 8px 12px;
  word-break: break-all;
}

.qr-area {
  width: 120px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12px;
}

.qr-image {
  width: 100px;
  height: 100px;
}

.qr-placeholder {
  width: 100px;
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F3F4F6;
  color: #9CA3AF;
  font-size: 12px;
  text-align: center;
}

.qr-label {
  margin-top: 8px;
  font-size: 12px;
  color: #6B7280;
}

.bottom-actions {
  display: flex;
  gap: 12px;
}

.bottom-actions .btn-block {
  flex: 1;
  margin-bottom: 0;
}
