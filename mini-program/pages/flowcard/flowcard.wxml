<view class="container">
  <view class="card flow-card">
    <view class="card-title" style="text-align: center; margin-bottom: 16px;">生产流转卡</view>
    <view class="flow-body">
      <view class="info-table">
        <view class="table-row">
          <view class="table-label">工单编号</view>
          <view class="table-value">{{workOrder.work_no || '-'}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">产品名称</view>
          <view class="table-value">{{workOrder.product_name || '-'}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">规格</view>
          <view class="table-value">{{workOrder.spec || '-'}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">颜色</view>
          <view class="table-value">{{workOrder.color || '-'}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">计划数量</view>
          <view class="table-value">{{workOrder.plan_quantity || 0}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">计划开始</view>
          <view class="table-value">{{workOrder.start_date || '-'}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">计划完成</view>
          <view class="table-value">{{workOrder.end_date || '-'}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">工艺路线</view>
          <view class="table-value">{{workOrder.process_route || '-'}}</view>
        </view>
        <view class="table-row">
          <view class="table-label">备注</view>
          <view class="table-value">{{workOrder.remark || '-'}}</view>
        </view>
      </view>
      <view class="qr-area">
        <image wx:if="{{flowCard.image_url}}" class="qr-image" src="{{flowCard.image_url}}" mode="aspectFit" show-menu-by-longpress />
        <view wx:else class="qr-placeholder">二维码生成中</view>
        <view class="qr-label">二维码</view>
      </view>
    </view>
  </view>

  <view class="bottom-actions">
    <button class="btn-secondary btn-block" bindtap="closePage">关闭</button>
    <button class="btn-primary btn-block" bindtap="printCard">打印</button>
  </view>
</view>
