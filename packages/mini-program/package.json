{
  "name": "mini-program",
  "version": "1.0.0",
  "private": true,
  "description": "金龙工艺小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "tailwindcss"
  },
  "scripts": {
    "build:weapp": "pnpm exec taro build --type weapp",
    "build:swan": "pnpm exec taro build --type swan",
    "build:alipay": "pnpm exec taro build --type alipay",
    "build:tt": "pnpm exec taro build --type tt",
    "build:h5": "pnpm exec taro build --type h5",
    "build:rn": "pnpm exec taro build --type rn",
    "build:qq": "pnpm exec taro build --type qq",
    "build:jd": "pnpm exec taro build --type jd",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "lint": "tsc --noEmit"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@supabase/supabase-js": "^2.43.0",
    "@tarojs/components": "4.0.9",
    "@tarojs/helper": "4.0.9",
    "@tarojs/plugin-framework-react": "4.0.9",
    "@tarojs/plugin-platform-alipay": "4.0.9",
    "@tarojs/plugin-platform-h5": "4.0.9",
    "@tarojs/plugin-platform-jd": "4.0.9",
    "@tarojs/plugin-platform-qq": "4.0.9",
    "@tarojs/plugin-platform-swan": "4.0.9",
    "@tarojs/plugin-platform-tt": "4.0.9",
    "@tarojs/plugin-platform-weapp": "4.0.9",
    "@tarojs/react": "4.0.9",
    "@tarojs/runtime": "4.0.9",
    "@tarojs/shared": "4.0.9",
    "@tarojs/taro": "4.0.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@tarojs/cli": "4.0.9",
    "@types/react": "^18.2.0",
    "@types/webpack-env": "^1.18.4",
    "autoprefixer": "^10.4.18",
    "babel-preset-taro": "4.0.9",
    "css-loader": "^6.10.0",
    "postcss": "^8.4.35",
    "postcss-loader": "^8.1.1",
    "react-refresh": "^0.14.0",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.1",
    "taro-plugin-tailwind": "^1.3.3",
    "terser-webpack-plugin": "^5.3.10",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0"
  }
